{
  "name": "@hlw-uni-mp/vite-plugin",
  "version": "1.0.15",
  "description": "HLW Vite Plugin for auto app environment variables and type definitions",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^5.2.8"
  },
  "license": "MIT",
  "dependencies": {
    "unplugin-auto-import": "^0.17.5"
  }
}
